{
  "name": "opencode-go",
  "version": "0.1.0",
  "description": "OpenCode Go subscription models in Velloc: the gateway's live model list, plan usage windows and the session header the gateway requires.",
  "author": {
    "name": "VellocLabs"
  },
  "license": "Apache-2.0",
  "keywords": [
    "mod",
    "provider",
    "opencode",
    "opencode-go"
  ],
  "providers": {
    "go": {
      "providerApi": 1,
      "displayName": {
        "en": "OpenCode Go"
      },
      "icon": "./icon.svg",
      "defaultBaseUrl": "https://opencode.ai/zen/go/v1",
      "domains": [
        "opencode.ai"
      ],
      "format": "openai-chat",
      "credentials": {
        "methods": [
          "apiKey"
        ],
        "prompts": [
          {
            "type": "text",
            "key": "api_key",
            "message": {
              "en": "OpenCode Go API key",
              "zh-CN": "OpenCode Go API 密钥",
              "ja": "OpenCode Go API キー",
              "ko": "OpenCode Go API 키",
              "es": "Clave de API de OpenCode Go",
              "fr": "Clé API OpenCode Go",
              "de": "OpenCode Go API-Schlüssel"
            },
            "placeholder": {
              "en": "Paste the key from your OpenCode account",
              "zh-CN": "粘贴你的 OpenCode 账户中的密钥",
              "ja": "OpenCode アカウントのキーを貼り付けてください",
              "ko": "OpenCode 계정의 키를 붙여넣으세요",
              "es": "Pegue la clave de su cuenta de OpenCode",
              "fr": "Collez la clé de votre compte OpenCode",
              "de": "Füge den Schlüssel aus deinem OpenCode-Konto ein"
            },
            "secret": true
          }
        ]
      },
      "modelsUi": {
        "intro": {
          "en": "Models are grouped by the company that makes them. Add one that is not listed with Add custom model.",
          "zh-CN": "模型按其所属公司分组;未列出的模型可用“添加自定义模型”手动添加。",
          "ja": "モデルは提供元の会社ごとに分類されています。一覧にないモデルは「カスタムモデルを追加」で追加できます。",
          "ko": "모델은 만든 회사별로 묶여 있습니다. 목록에 없는 모델은 \"사용자 지정 모델 추가\"로 추가할 수 있습니다.",
          "es": "Los modelos se agrupan por la empresa que los desarrolla; añada uno que no figure con «Añadir modelo personalizado».",
          "fr": "Les modèles sont regroupés par entreprise ; ajoutez un modèle absent de la liste avec « Ajouter un modèle personnalisé ».",
          "de": "Die Modelle sind nach dem Unternehmen gruppiert, das sie herstellt; ein nicht aufgeführtes Modell fügst du mit „Eigenes Modell hinzufügen“ hinzu."
        },
        "empty": {
          "en": "No models listed. Check the key, then refresh the list.",
          "zh-CN": "没有可用模型。请检查密钥,然后刷新列表。",
          "ja": "利用できるモデルがありません。キーを確認してから、一覧を更新してください。",
          "ko": "사용할 수 있는 모델이 없습니다. 키를 확인한 뒤 목록을 새로 고치세요.",
          "es": "No hay modelos. Compruebe la clave y actualice la lista.",
          "fr": "Aucun modèle listé. Vérifiez la clé, puis actualisez la liste.",
          "de": "Keine Modelle aufgeführt. Prüfe den Schlüssel und aktualisiere die Liste."
        },
        "links": [
          {
            "label": {
              "en": "OpenCode docs",
              "zh-CN": "OpenCode 文档",
              "ja": "OpenCode ドキュメント",
              "ko": "OpenCode 문서",
              "es": "Documentación de OpenCode",
              "fr": "Documentation OpenCode",
              "de": "OpenCode-Dokumentation"
            },
            "url": "https://opencode.ai/docs/zen/"
          }
        ],
