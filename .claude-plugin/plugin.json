        "tags": {
          "custom": {
            "label": {
              "en": "Custom",
              "zh-CN": "自定义",
              "ja": "カスタム",
              "ko": "사용자 지정",
              "es": "Personalizado",
              "fr": "Personnalisé",
              "de": "Eigen"
            }
          }
        },
        "customModels": {
          "formats": [
            "openai-chat",
            "openai-responses",
            "anthropic-messages",
            "gemini"
          ],
          "wires": {
            "openai-chat": {
              "compat": {
                "maxTokensField": "max_tokens",
                "developerRole": false
              }
            },
            "openai-responses": {
              "compat": {
                "developerRole": false
              }
            },
            "anthropic-messages": {
              "baseUrlTrim": "/v1"
            },
            "gemini": {
              "headers": {
                "x-goog-api-key": "{{secret:api_key}}"
              }
            }
          }
        },
        "starterModels": [
          "glm-5.3",
          "kimi-k3",
          "minimax-m3",
          "glm-5.3-flash"
        ],
        "tierModels": {
          "fast": "glm-5.3-flash"
        }
